# Что НЕ отправлять демону Docker при сборке.
#
# Файл обязан лежать в корне контекста сборки. В docker-compose.yml контекст
# задан как `..`, то есть корень репозитория, — а файл раньше лежал в docker/
# и не применялся вообще: в контекст уходили docs/images (16 МБ), история git
# и колёса пакетов, и сборка начиналась с многосекундной пересылки.

.git/
.gitignore
.github/

# Документация: в образ — только главы и картинки для раздела
# «Документация»; сборочные сценарии руководства не нужны.
docs/*
!docs/*.md
!docs/images
build/
benchmarks/
examples/

# Шаблон без «**/» действует только в корне контекста: __pycache__ из
# server/asrhub и .pytest_cache из tests уезжали в образ, а docker/data
# (база и модели при запуске по README) и docker/.env с токеном — в контекст
# сборки. Поэтому вложенные пути — явно.

# Тесты в образе не нужны
tests/

# Окружения и кеши
.venv/
venv/
env/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.egg-info/
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
node_modules/

# Данные и результаты работы
data/
docker/data/
docker/certs/
**/*.db
**/*.db-shm
**/*.db-wal
**/*.log
*.wav
*.mp3
*.m4a

# Пакеты, скачанные вручную
*.whl
*.tar.gz
*.zip

# Локальные настройки и секреты
**/.env
config/local*.yaml
.DS_Store
