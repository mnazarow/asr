# Что не должно попадать в репозиторий.
#
# Каталог docker — рабочий: установка и запуск по README кладут туда .env
# (с токеном Hugging Face), data/ (база, модели, расшифровки) и certs/.
docker/.env
docker/data/
docker/certs/

# Окружения и кеши
venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Сборки и пакеты
build/
*.whl

# Рабочая машина: данные сервера, запущенного из клона, и служебное
# редакторов (перенесено из прежнего локального .gitignore)
dist/
*.py[co]
data/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
api-key.txt
.DS_Store
.idea/
.vscode/

# Результаты прогонов замеров (данные конкретной машины)
benchmarks/2*-*.json
benchmarks/2*-*.md
